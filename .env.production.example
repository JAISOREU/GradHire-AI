# Docker Compose Production Environment Variables
# Copy this file to .env and fill in real values

# Database
POSTGRES_USER=gradhire
POSTGRES_PASSWORD=your-secure-db-password-here
POSTGRES_DB=gradhire
DATABASE_URL=postgresql://gradhire:your-secure-db-password-here@postgres:5432/gradhire?schema=public

# Backend
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://ai-service:8000

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
SMTP_FROM=GradHire AI <noreply@yourdomain.com>

# CORS
CORS_ORIGIN=https://gradture.ai,https://www.gradture.ai,https://admin.gradture.ai
FRONTEND_URL=https://gradture.ai

# Redis
REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379

# Storage (Cloudflare R2)
STORAGE_PROVIDER=r2
STORAGE_LOCAL_PATH=./uploads
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET=gradhire-uploads
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key

# Monitoring
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=gradhire@1.0.0
VITE_SENTRY_DSN=your-sentry-dsn
VITE_APP_VERSION=1.0.0
LOG_LEVEL=info

# Admin Setup
ADMIN_SETUP_SECRET=your-admin-setup-secret-here
