# Docker Compose Production Environment Variables
# Copy this file to .env and fill in real values

# Database
POSTGRES_USER=gradhire
POSTGRES_PASSWORD=your-secure-db-password-here
POSTGRES_DB=gradhire
DATABASE_URL=postgresql://gradhire:your-secure-db-password-here@postgres:5432/gradhire?schema=public

# Backend
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
AI_SERVICE_URL=http://ai-service:8000

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=GradHire AI <noreply@yourdomain.com>

# CORS
CORS_ORIGIN=https://your-frontend-app.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# AI Service
OPENAI_API_KEY=your-openai-api-key
