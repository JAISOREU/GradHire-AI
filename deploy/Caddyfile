# GradHire AI — Caddy Reverse Proxy Configuration
# Deploy to: /etc/caddy/Caddyfile on your Oracle Cloud VM
#
# After deploying, run:
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

{
	# Global options
	email admin@gradture.ai
}

# Frontend
gradture.ai {
	reverse_proxy localhost:80
}

www.gradture.ai {
	reverse_proxy localhost:80
}

# Backend API
api.gradture.ai {
	reverse_proxy localhost:3000
}

# Admin panel
admin.gradture.ai {
	reverse_proxy localhost:3000
}

# AI Service (optional, if you want it public)
# ai.gradture.ai {
# 	reverse_proxy localhost:8000
# }
