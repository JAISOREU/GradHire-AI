# Backend Production Environment Variables
# Reference only — nothing loads a .env.production file. The deployed backend
# receives these variables from the root .env (single source of truth) pasted
# into the Render dashboard; scripts\render-env.ps1 emits the paste-ready
# block. NODE_ENV=production is part of that block.
#
# This file is generated from the ACTUAL process.env reads in src/ — every
# variable below is consumed by code when NODE_ENV=production. See
# backend/src/** for the authoritative usage sites.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- Database (Neon Postgres or any Postgres 14+) ---
# Neon: copy the pooled or non-pooled URL from the dashboard and append SSL:
#   postgresql://user:password@ep-xxx-xxx.aws.neon.tech/gradhire?sslmode=require&schema=public
DATABASE_URL=postgresql://user:password@host:5432/gradhire?sslmode=require&schema=public

# --- Authentication ---
# REQUIRED. min 32 chars. Verify with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=7d

# --- Frontend / CORS / cookie policy ---
# The deployed frontend origin(s). In production the API sets SameSite=None;
# Secure cookies, so every browser-origin that calls the API must be listed.
CORS_ORIGIN=https://your-frontend-app.vercel.app
# Used for password-reset / email-verify links.
FRONTEND_URL=https://your-frontend-app.vercel.app
# Public callback host for OAuth redirect URIs (defaults to port 3000 guess).
BACKEND_URL=https://your-backend-app.example.com
# Host the auth cookies are served for (used to decide SameSite policy; leave
# default unless the API is behind a CDN with a different host).
# COOKIE_SERVER_HOST=your-backend-app.example.com

# --- Session / cache (Redis) ---
# Health check reports redis down and caching is disabled when absent.
REDIS_URL=redis://:password@your-redis-host:6379
REDIS_PASSWORD=

# --- Email (Resend) ---
# REQUIRED for real email in production (password reset, email verify).
# The service ONLY uses Resend + SMTP_FROM; SMTP_HOST/PORT/USER/PASS are NOT
# consumed. Missing RESEND_API_KEY in production makes send() throw (by design).
RESEND_API_KEY=your-resend-api-key
SMTP_FROM=GradTure <noreply@yourdomain.com>

# --- AI provider (primary + optional fallback/alternates) ---
# AI_PROVIDER: gemini | openai | groq | ollama
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192

# OpenAI (optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=8192

# Groq (optional)
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_TEMPERATURE=0.7
# GROQ_MAX_TOKENS=8192

# Ollama (optional, self-hosted)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_MAX_TOKENS=8192

# --- OAuth providers (all optional; omit to disable that provider) ---
# Google
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GitHub
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# LinkedIn
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# --- Storage: local | s3 | r2 (STORAGE_PROVIDER required; local is dev default) ---
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (STORAGE_PROVIDER=s3)
# S3_BUCKET=gradhire-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key

# Cloudflare R2 (STORAGE_PROVIDER=r2)
# R2_BUCKET=gradhire-uploads
# R2_ACCOUNT_ID=your-r2-account-id
# R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
# R2_ACCESS_KEY=your-r2-access-key
# R2_SECRET_KEY=your-r2-secret-key

# --- Monitoring (Sentry) ---
SENTRY_DSN=your-sentry-dsn
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=gradture@1.0.0

# --- Deployment platform ---
# Render (free web service): set NODE_ENV=production here or in the dashboard.