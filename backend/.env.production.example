# Backend Production Environment Variables
# Copy this file to .env.production and fill in real values

NODE_ENV=production
PORT=3000

# Database (Supabase / Railway Postgres / AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/gradhire?schema=public

# Authentication
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=7d

# AI Service (Railway / Fly.io / AWS)
AI_SERVICE_URL=https://your-ai-service-url.com

# Email (SendGrid / AWS SES / Mailgun)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=GradHire AI <noreply@yourdomain.com>
EMAIL_FROM=noreply@yourdomain.com

# CORS (Vercel frontend URL)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Frontend URL (for email links)
FRONTEND_URL=https://your-frontend-app.vercel.app
