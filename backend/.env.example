DATABASE_URL=postgresql://user:password@localhost:5432/gradhire
POSTGRES_USER=gradhire
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=gradhire
JWT_SECRET=your-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=7d
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

RESEND_API_KEY=your-resend-api-key
SMTP_FROM=noreply@gradture.local

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

REDIS_URL=redis://localhost:6379

SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_APP_VERSION=1.0.0
LOG_LEVEL=debug

# AI Configuration (provider-agnostic)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=8192

# Groq Configuration (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=8192

# Ollama Configuration (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=8192

SERVICE_URL=http://localhost:8000
ADMIN_SETUP_SECRET=your-admin-setup-secret-here

JOB_INGESTION_ENABLED=true
JOB_INGESTION_CONCURRENCY=3
JOB_INGESTION_TIMEOUT_MS=30000

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
