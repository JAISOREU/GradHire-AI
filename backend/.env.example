# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://gradhire:gradhire@localhost:5432/gradhire"

# JWT — MUST set a strong secret in production
JWT_SECRET=gradture-dev-secret-change-me
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Redis (optional but recommended for rate limiting / caching)
REDIS_URL=redis://localhost:6379

# Email (configure for production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gradhire.ai

# File storage (S3/R2 or local path)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI Service
AI_SERVICE_URL=http://localhost:8000
