{
  "name": "gradture-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "prisma migrate deploy && node dist/main.js",
    "start:dev": "node -r ts-node/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "test": "cross-env DATABASE_URL=postgresql://postgres:@localhost:5432/gradhire_test JWT_SECRET=test-secret-for-unit-tests-only node -r ts-node/register --test --test-concurrency=1 src/**/*.spec.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.5",
    "@prisma/client": "^6.19.3",
    "@sentry/nestjs": "^10.70.0",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.19.0",
    "rxjs": "^7.0.0",
    "socket.io": "^4.8.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.11",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^7.2.1",
    "@types/xml2js": "^0.4.14",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "multer": "$multer",
    "qs": "6.16.0",
    "lodash": "4.18.1",
    "deepmerge-ts": "8.0.2",
    "file-type": "21.3.4",
    "js-yaml": "5.4.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@nestjs/core@11.2.5": true,
    "esbuild@0.28.2": true
  }
}
