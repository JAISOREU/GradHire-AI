# Frontend Production Environment Variables
# VITE_API_URL should point to your Railway backend WITHOUT a trailing slash.
# The frontend already includes /api/v1 in request paths.
# Example: VITE_API_URL=https://gradhire-ai-production.up.railway.app
VITE_API_URL=https://gradhire-ai-production.up.railway.app
VITE_SENTRY_DSN=your-sentry-dsn
VITE_APP_VERSION=1.0.0
